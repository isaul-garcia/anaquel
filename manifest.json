{
  "manifest_version": 3,
  "name": "Anaquel \u2014 a home for your bookmarks",
  "version": "1.0.13",
  "description": "A visual shelf for your bookmarks. Explore folders, pin favorites, and make room for your next discovery.",
  "minimum_chrome_version": "114",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon"
  ],
  "action": {
    "default_title": "Show bookmarks for this site",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "bookmarks": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
